# Core infrastructure
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/ca_saas

# AWS (only required when LOCAL_STORAGE=false)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=ca-saas-documents
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy

# Local file storage (dev only — replaces S3 for local development)
LOCAL_STORAGE=false
LOCAL_STORAGE_PATH=./local-storage

# Groq (LLM extraction)
GROQ_API_KEY=gsk-your-groq-api-key-here

# Backend <-> AI service
AI_SERVICE_API_KEY=replace-with-a-random-32-plus-char-service-secret
AI_SERVICE_PORT=8001
AI_WRITE_BACK_ENABLED=true

# OCR / LLM tuning
TESSERACT_CMD=
LLM_TIMEOUT_SECONDS=60
MAX_PDF_PAGES_FOR_FALLBACK=3
MAX_TOOL_UPLOAD_MB=25
