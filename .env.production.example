# =============================================================================
# Verax TallyOCR — Production Environment Variables
# =============================================================================
# Reference for deploying backend + worker + ai-service + frontend to production.
# Every variable below is documented with: what it does, required/optional, and
# an example value (NOT a real credential — generate/obtain your own for prod).
#
# Sources cross-checked against:
#   backend/src/config/env.js       (Joi schema — authoritative for backend/worker)
#   ai-service/app/config.py        (Settings.validate() — authoritative for ai-service)
#   docker-compose.yml / docker-compose.prod.yml
#   render.yaml
#
# Consumed by: backend (API), worker (BullMQ document processor), ai-service
# (FastAPI OCR/LLM), frontend (Vite build-time only). Each var below is a real
# runtime default from docker-compose.yml unless noted "no default — must be set".
# =============================================================================


# =============================================================================
# DATABASE
# =============================================================================

# Full Postgres connection string. Used by backend/worker/ai-service to run
# migrations (knex needs DDL rights: CREATE TABLE/POLICY/ROLE).
# Required. No default — must be set.
DATABASE_URL=postgresql://ca_user:REPLACE_WITH_STRONG_PASSWORD@your-prod-db-host:5432/ca_saas

# Postgres container credentials — only used if you run Postgres via the
# provided docker-compose files rather than a managed DB (e.g. RDS/Supabase).
# Required if self-hosting Postgres via docker-compose. Optional/unused with a managed DB.
POSTGRES_DB=ca_saas
POSTGRES_USER=ca_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Least-privilege connection string for the app's actual runtime queries
# (backend API, worker, ai-service write-backs) — NOT the same role as
# DATABASE_URL. This matters because Postgres never applies Row Level
# Security to a superuser, and DATABASE_URL's role (the docker-compose
# bootstrap user, or in some self-managed setups the DB's admin role) often
# IS one. Without this set, RLS's tenant isolation is silently bypassed and
# one firm can read another firm's data through this deployment.
# Required if self-hosting via docker-compose (run migrations first — they
# create the `ca_app` role — then point this at it). A managed Postgres
# provider (e.g. Render) already gives you a non-superuser connection role
# by default, so this can be left unset there; DATABASE_URL is already safe.
APP_DB_PASSWORD=REPLACE_WITH_ANOTHER_STRONG_PASSWORD
APP_DATABASE_URL=postgresql://ca_app:REPLACE_WITH_ANOTHER_STRONG_PASSWORD@your-prod-db-host:5432/ca_saas


# =============================================================================
# AUTH
# =============================================================================

# Signing secret for short-lived (15 min) firm-user JWT access tokens.
# Required. Min 32 chars. No default — must be set.
JWT_SECRET=replace-with-a-random-32-plus-char-secret

# Signing secret for the httpOnly refresh-token cookie (7 day chain, rotated on use).
# Required. Min 32 chars. Must differ from JWT_SECRET. No default — must be set.
JWT_REFRESH_SECRET=replace-with-another-random-32-plus-char-secret

# Signing secret for the separate client-portal auth world (magic-link clients).
# Required. Min 32 chars. Backend refuses to start if this equals JWT_SECRET or
# JWT_REFRESH_SECRET. No default — must be set.
CLIENT_JWT_SECRET=client_jwt_secret_key_min_32_chars_long_and_unique

# Client-portal access token lifetime (e.g. "15m", "1h").
# Optional. Default: 15m.
CLIENT_JWT_EXPIRY=15m

# Client-portal refresh token lifetime, in days.
# Optional. Default: 30.
CLIENT_REFRESH_TOKEN_EXPIRY_DAYS=30

# Firm-user access token lifetime, in minutes.
# Optional. Default: 15.
ACCESS_TOKEN_TTL_MINUTES=15

# Firm-user refresh token lifetime, in days.
# Optional. Default: 7.
REFRESH_TOKEN_TTL_DAYS=7

# Name of the httpOnly cookie holding the firm-user refresh token.
# Optional. Default: ca_refresh_token.
REFRESH_COOKIE_NAME=ca_refresh_token

# Whether a client upload link is replaced after every upload. When false, the
# same link keeps working until it expires; firms can reset it from the client page.
# Optional. Default: false.
MAGIC_LINK_SINGLE_USE=false

# How many hours a client upload link stays valid (720 = 30 days).
# Optional. Default: 720.
MAGIC_LINK_EXPIRY_HOURS=720


# =============================================================================
# EMAIL
# =============================================================================

# Which email transport to use: "smtp" or "resend".
# Optional. Default: smtp.
EMAIL_PROVIDER=resend

# How admins get "document ready" emails: digest (one each morning, 08:00 IST),
# instant (one per document) or off (in-app notifications only).
# Failure alerts are always emailed right away. Optional. Default: digest.
DOCUMENT_READY_EMAILS=digest

# API key for Resend. Required only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=re_replace_with_real_resend_api_key

# SMTP host/port/credentials. Required only when EMAIL_PROVIDER=smtp.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password

# Display name and address used as the "From" header on all outbound email.
# Optional. Defaults: "Verax TallyOCR" / noreply@verax.in.
EMAIL_FROM_NAME=Verax TallyOCR
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# Mailbox that receives "Request a Demo" landing-page lead notifications.
# Optional. Default: verax.hello@gmail.com — set to a real monitored inbox in prod.
DEMO_NOTIFICATION_EMAIL=leads@yourdomain.com


# =============================================================================
# AI SERVICE
# =============================================================================

# Groq API key used by ai-service for LLM structured extraction
# (openai/gpt-oss-120b, overridable via GROQ_MODEL). Required by ai-service (Settings.validate()).
# No default — must be set.
GROQ_API_KEY=gsk-replace-with-real-groq-api-key

# Base URL the backend/worker use to reach ai-service.
# Required (backend/worker). Example below is for the bundled docker-compose
# network; point this at your ai-service's public/internal URL in prod.
AI_SERVICE_URL=http://ai-service:8001

# Shared secret required on every backend/worker -> ai-service call (checked by
# ai-service via a header). Must be the SAME value on backend, worker, and
# ai-service. Required (min 32 chars in production per env.js). No default.
AI_SERVICE_API_KEY=replace-with-a-random-32-plus-char-service-secret

# Port ai-service's FastAPI process binds to inside its container.
# Optional. Default: 8001.
AI_SERVICE_PORT=8001

# How long (ms) the backend/worker wait for an ai-service /process call before
# timing out. Long scanned statements (OCR at ~10s a page) need minutes.
# Optional. Default: 900000 (15 min).
AI_SERVICE_TIMEOUT_MS=900000

# Whether ai-service writes extraction results directly back to Postgres.
# Optional. Default: true.
AI_WRITE_BACK_ENABLED=true

# Per-request timeout (seconds) for the Groq LLM call.
# Optional. Default: 60.
LLM_TIMEOUT_SECONDS=60

# Wall-clock timeout (seconds) per OCR engine (PaddleOCR, then Tesseract if
# it falls back) before that engine is abandoned for the page set. Guards
# against a pathological image hanging the worker indefinitely.
# Optional. Default: 120.
OCR_TIMEOUT_SECONDS=120

# Max PDF pages ai-service will OCR-fallback-process for a single document
# (caps cost/latency on huge PDFs). Optional. Default: 3.
MAX_PDF_PAGES_FOR_FALLBACK=3

# Explicit path to the tesseract binary, only needed if it's not on PATH
# (the production Docker image installs it at the standard location).
# Optional. Default: auto-detected.
TESSERACT_CMD=


# =============================================================================
# STORAGE
# =============================================================================

# Set to false in production — this enables S3-backed storage instead of the
# local-disk fallback used for dev. Optional. Default: false.
LOCAL_STORAGE=false

# Only used when LOCAL_STORAGE=true (dev only) — where uploaded files are
# written on disk. Not applicable in production. Optional. Default: ./local-storage.
LOCAL_STORAGE_PATH=./local-storage

# AWS region the S3 bucket lives in.
# Optional. Default: ap-south-1.
AWS_REGION=ap-south-1

# S3 bucket used for document uploads and Tally XML export downloads.
# Required when LOCAL_STORAGE=false (the default/prod case). No default.
AWS_S3_BUCKET=your-prod-bucket-name

# IAM credentials with read/write/presign access to AWS_S3_BUCKET.
# Required when LOCAL_STORAGE=false. Prefer a scoped IAM user/role over
# account root keys. No default — must be set.
AWS_ACCESS_KEY_ID=REPLACE_WITH_REAL_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_REAL_AWS_SECRET_ACCESS_KEY

# How long presigned upload URLs stay valid, in seconds.
# Optional. Default: 900 (15 min).
UPLOAD_URL_EXPIRY_SECONDS=900

# How long presigned Tally XML export download URLs stay valid, in seconds.
# Optional. Default: 900 (15 min).
TALLY_EXPORT_URL_EXPIRY_SECONDS=900

# Max size (MB) accepted for a client document upload.
# Optional. Default: 50.
MAX_UPLOAD_MB=50

# Max size (MB) accepted for ad-hoc tool uploads (e.g. register cleaner).
# Optional. Default: 25.
MAX_TOOL_UPLOAD_MB=25


# =============================================================================
# REDIS
# =============================================================================

# Redis connection string, used by BullMQ for the document-processing queue
# and by the scheduled-requests cron job. Required. No default — must be set.
REDIS_URL=redis://your-prod-redis-host:6379

# How many documents the worker processes concurrently.
# Optional. Default: 3. Tune based on ai-service throughput/capacity.
DOCUMENT_WORKER_CONCURRENCY=3


# =============================================================================
# FRONTEND
# =============================================================================

# Public URL of the deployed backend API. Baked into the frontend at BUILD
# TIME (Vite) — changing it requires a rebuild, not just a redeploy.
# MUST share a registrable domain with FRONTEND_URL (e.g. api.yourdomain.in
# + app.yourdomain.in): the refresh cookie is SameSite=Strict, so on
# *.vercel.app + *.onrender.com users are logged out on every page reload.
# Required for the frontend build. No default — must be set.
VITE_API_BASE_URL=https://api.yourdomain.com

# Public URL of the deployed frontend. Used by the backend for CORS
# (Access-Control-Allow-Origin) and in outbound emails (magic links, etc).
# Required. No default — must be set.
FRONTEND_URL=https://app.yourdomain.com


# =============================================================================
# COMPLIANCE (GSP / GSTIN validation)
# =============================================================================

# NIC Adaequare GSP sandbox/production API base URL.
# Optional. Default: https://gsp.adaequare.com (sandbox).
GSP_API_URL=https://gsp.adaequare.com

# GSP API credentials. Leave blank (and set GSP_DISABLED=true) to always use
# the local GSTIN-checksum fallback instead of calling the GSP API.
# Optional.
GSP_USERNAME=
GSP_PASSWORD=

# Set to true to disable GSP calls entirely and always use local fallback
# validation. Optional. Default: false.
GSP_DISABLED=false


# =============================================================================
# NODE / RUNTIME
# =============================================================================

# How many reverse-proxy hops sit in front of the backend (Express
# "trust proxy"). Rate limiting and audit logs key on the client IP, which
# behind a proxy is otherwise the proxy's own address — every user then
# shares one rate-limit bucket and logins/refreshes start failing with 429.
# Render: 1. docker-compose.prod.yml: 1 (the caddy service; set there by
# default). Leave false only if the backend is exposed directly — trusting a
# proxy that isn't there lets clients spoof their IP via X-Forwarded-For.
# Optional. Default: false.
TRUST_PROXY=1

# Standard Node environment flag — set to "production" to disable verbose
# logging, enable stricter Joi validation branches (e.g. AI_SERVICE_API_KEY
# becomes required), etc. Required in effect (defaults to "development" if unset).
NODE_ENV=production

# Port the backend Express server binds to inside its container.
# Optional. Default: 3000.
PORT=3000

# Sentry DSN for backend + worker error monitoring. When unset, Sentry is not
# initialized and the app runs normally with no error reporting.
# Optional. No default (disabled).
SENTRY_DSN=
