# Core infrastructure
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/ca_saas
# Optional: least-privilege runtime connection (see docker-compose.yml comment
# and .env.production.example for why this matters for RLS). Not required for
# local dev against a single-tenant DB, but docker-compose.yml sets it by
# default so the pattern is exercised before it matters in production.
APP_DATABASE_URL=
REDIS_URL=redis://localhost:6379

# AWS
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
AWS_REGION=ap-south-1
AWS_S3_BUCKET=ca-saas-documents

# Auth
JWT_SECRET=replace-with-a-random-32-plus-char-secret
JWT_REFRESH_SECRET=replace-with-another-random-32-plus-char-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=ca_refresh_token

# Client portal auth — a completely separate auth world from the CA firm portal.
# CLIENT_JWT_SECRET MUST be different from JWT_SECRET / JWT_REFRESH_SECRET
# (the backend refuses to start if it matches either).
CLIENT_JWT_SECRET=client_jwt_secret_key_min_32_chars_long
CLIENT_JWT_EXPIRY=15m
CLIENT_REFRESH_TOKEN_EXPIRY_DAYS=30

# Local disk storage instead of S3 (skips the AWS_S3_BUCKET requirement)
LOCAL_STORAGE=false

# Sentry error monitoring (optional — leave blank to disable)
SENTRY_DSN=

# AI service
GROQ_API_KEY=gsk-your-groq-api-key-here
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=replace-with-a-random-32-plus-char-service-secret
AI_SERVICE_TIMEOUT_MS=120000
AI_WRITE_BACK_ENABLED=true
LLM_TIMEOUT_SECONDS=60
OCR_TIMEOUT_SECONDS=120
MAX_PDF_PAGES_FOR_FALLBACK=3

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000

# Email provider: 'smtp' or 'resend' (default: smtp)
EMAIL_PROVIDER=smtp

# Resend (if EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# SMTP (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sender identity
EMAIL_FROM_NAME=Verax TallyOCR
EMAIL_FROM_ADDRESS=noreply@verax.in

# Where "Request a Demo" lead notifications are sent
DEMO_NOTIFICATION_EMAIL=verax.hello@gmail.com

# GSP API Integration (NIC Adaequare sandbox for dev)
GSP_API_URL=https://gsp.adaequare.com
GSP_USERNAME=
GSP_PASSWORD=
# Set to 'true' to disable GSP and always use local fallback (useful for dev)
GSP_DISABLED=false

# Local docker defaults
POSTGRES_DB=ca_saas
POSTGRES_USER=ca_user
POSTGRES_PASSWORD=ca_password

# Upload/magic-link behavior
MAGIC_LINK_SINGLE_USE=true
MAGIC_LINK_EXPIRY_HOURS=24
UPLOAD_URL_EXPIRY_SECONDS=900
TALLY_EXPORT_URL_EXPIRY_SECONDS=900
MAX_UPLOAD_MB=50
MAX_TOOL_UPLOAD_MB=25
DOCUMENT_WORKER_CONCURRENCY=3

# Confidence score below which a processed document is routed to
# review_required instead of extracted (0-1). Also forced to review when the
# AI service flags a multi-page PDF as truncated.
REVIEW_CONFIDENCE_THRESHOLD=0.4

# Set to false only when running the scheduled-requests worker as its own
# deployable process (npm run worker:scheduled-requests) instead of embedded
# inside the document-processing worker. Leave true for the default single-
# worker deployment (render.yaml's verax-worker service).
SCHEDULED_REQUESTS_EMBEDDED=true
