# Core infrastructure
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/ca_saas
REDIS_URL=redis://localhost:6379

# AWS
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
AWS_REGION=ap-south-1
AWS_S3_BUCKET=ca-saas-documents

# Auth
JWT_SECRET=replace-with-a-random-32-plus-char-secret
JWT_REFRESH_SECRET=replace-with-another-random-32-plus-char-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=ca_refresh_token

# AI service
OPENAI_API_KEY=sk-your-openai-api-key-here
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=replace-with-a-random-32-plus-char-service-secret
AI_SERVICE_TIMEOUT_MS=120000
OPENAI_MODEL=gpt-4o
AI_WRITE_BACK_ENABLED=true
LLM_TIMEOUT_SECONDS=60
TEXTRACT_TIMEOUT_SECONDS=60
MAX_PDF_PAGES_FOR_FALLBACK=3

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000

# Email provider: 'smtp' or 'resend' (default: smtp)
EMAIL_PROVIDER=smtp

# Resend (if EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# SMTP (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sender identity
EMAIL_FROM_NAME=Verax TallyOCR
EMAIL_FROM_ADDRESS=noreply@verax.in

# GSP API Integration (NIC Adaequare sandbox for dev)
GSP_API_URL=https://gsp.adaequare.com
GSP_USERNAME=
GSP_PASSWORD=
# Set to 'true' to disable GSP and always use local fallback (useful for dev)
GSP_DISABLED=false

# Local docker defaults
POSTGRES_DB=ca_saas
POSTGRES_USER=ca_user
POSTGRES_PASSWORD=ca_password

# Upload/magic-link behavior
MAGIC_LINK_SINGLE_USE=true
MAGIC_LINK_EXPIRY_HOURS=24
UPLOAD_URL_EXPIRY_SECONDS=900
TALLY_EXPORT_URL_EXPIRY_SECONDS=900
MAX_UPLOAD_MB=50
MAX_TOOL_UPLOAD_MB=25
DOCUMENT_WORKER_CONCURRENCY=3
